# Tracehound Indexer Environment Variables
# 🐕 Copy this file to .env and customize values
#
# cp .env.example .env

# ============================================================================
# PostgreSQL Configuration
# ============================================================================
POSTGRES_PASSWORD=trackhound123
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=hound
POSTGRES_DATABASE=tracehound

# Alternative: Use a full connection URL
# POSTGRES_URL=postgres://hound:trackhound123@localhost:5432/tracehound?sslmode=disable

# ============================================================================
# Hyperliquid Configuration
# ============================================================================
HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws

# ============================================================================
# Kafka Configuration
# ============================================================================
KAFKA_BROKER=localhost:9092
KAFKA_TOPIC=whale_scents

# For multiple brokers (comma-separated)
# KAFKA_BROKERS=kafka1:9092,kafka2:9092,kafka3:9092

# ============================================================================
# Logging Configuration
# ============================================================================
# Log level: debug, info, warn, error
LOG_LEVEL=info

# Log format: json or text
LOG_FORMAT=json

# ============================================================================
# Application Configuration
# ============================================================================
# Batch size for processing events
BATCH_SIZE=100

# Batch timeout in seconds
BATCH_TIMEOUT=1s
