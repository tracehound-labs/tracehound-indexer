# Tracehound Indexer Environment Variables
# 🐕 Copy this file to .env and customize values
#
# cp .env.example .env
#
# SECURITY NOTES:
# - PostgreSQL and Kafka ports are NOT exposed to host by default
# - Only internal container communication is allowed
# - Keep your .env file secure and never commit it to version control
# - Use strong passwords with special characters

# ============================================================================
# PostgreSQL Configuration (REQUIRED - change the password!)
# ============================================================================
# Use a strong password: mix of upper/lower case, numbers, special chars
POSTGRES_PASSWORD=CHANGE_ME_Use_Strong_Password_123!

# Optional overrides (defaults shown, internal network)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=hound
POSTGRES_DATABASE=tracehound

# Alternative: Use a full connection URL (overrides individual settings above)
# POSTGRES_URL=postgres://hound:password@postgres:5432/tracehound?sslmode=disable

# ============================================================================
# Hyperliquid Configuration
# ============================================================================
HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws

# Coins to track (comma-separated, case-insensitive)
# Popular options: BTC, ETH, SOL, HYPE, DOGE, XRP, AVAX, LINK, ARB, OP, SUI
# Meme coins: WIF, PEPE, BONK
# Others: JUP, ONDO, TIA, SEI, INJ
TRACK_COINS=BTC,ETH,SOL,HYPE

# ============================================================================
# Kafka Configuration (internal network)
# ============================================================================
KAFKA_BROKER=kafka:29092
KAFKA_TOPIC=whale_scents

# For multiple brokers (comma-separated)
# KAFKA_BROKERS=kafka1:9092,kafka2:9092,kafka3:9092

# ============================================================================
# Logging Configuration
# ============================================================================
# Log level: debug, info, warn, error
LOG_LEVEL=info

# Log format: json or text
LOG_FORMAT=json
